menu "ForgeSense AI"

config FORGESENSE_UART_PORT
    int "FPGA link UART port"
    range 1 2
    default 1

config FORGESENSE_UART_TX_GPIO
    int "FPGA link TX GPIO"
    range 0 48
    default 17

config FORGESENSE_UART_RX_GPIO
    int "FPGA link RX GPIO"
    range 0 48
    default 18

config FORGESENSE_UART_BAUD
    int "FPGA link baud rate"
    range 9600 2000000
    default 115200

config FORGESENSE_EVENT_RING_SIZE
    int "Persistent critical-event ring size"
    range 16 256
    default 64

config FORGESENSE_LINK_LOSS_MS
    int "Sensor link loss detection interval in milliseconds"
    range 250 30000
    default 2000

config FORGESENSE_TELEMETRY_ENABLE
    bool "Emit read-only host telemetry records"
    default y
    help
        Emit @FS1 JSON monitoring records to ESP-IDF standard output. This
        transport is diagnostic-only and never reads actuator/control commands.

config FORGESENSE_TELEMETRY_PERIOD_MS
    int "Host telemetry publication interval in milliseconds"
    depends on FORGESENSE_TELEMETRY_ENABLE
    range 100 10000
    default 500
    help
        Periodic publication interval. Important FPGA state transitions may
        cause an earlier record so the dashboard does not wait for this period.

endmenu
